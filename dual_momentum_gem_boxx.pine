//@version=6
//
// Dual Momentum (GEM) — Quantitative Momentum Holdings + BOXX Defense
// -------------------------------------------------------------------
// A non-repainting implementation of Gary Antonacci's Global Equities Momentum
// (GEM) strategy with two modifications:
//   1. BOXX (box-spread cash proxy) replaces AGG as the risk-off holding.
//   2. Signals and holdings are decoupled: SPY / VXUS / BIL decide the regime
//      and geography, while QMOM / IMOM (Alpha Architect quantitative
//      momentum ETFs) provide the equity exposure actually held.
//
// Rules, evaluated once per completed month:
//   US momentum    = SPY  12-month total return (dividend adjusted)
//   Intl momentum  = VXUS 12-month total return (dividend adjusted)
//   Cash hurdle    = BIL (or SHV / BOXX / 3M T-bill yield series) 12-month return
//
//   If US momentum <= cash hurdle:        hold BOXX
//   Else if US momentum >= Intl momentum: hold QMOM
//   Else:                                 hold IMOM
//
// Three selectable modes:
//   * Baseline   — hold the signal ETFs themselves (classic GEM: SPY/VXUS/BOXX)
//   * Decoupled  — signal ETFs decide, holding ETFs are owned (default)
//   * Aggressive — momentum is computed directly on the holding ETFs
//                  (QMOM vs IMOM vs the cash hurdle)
//
// Execution convention (no repainting):
//   * Signals use only COMPLETED monthly closes (close[1] on the "M"
//     timeframe with lookahead, the standard confirmed-HTF pattern).
//   * The allocation switches at the start of the next month and is held
//     until the next rebalance. The synthetic portfolio return for a month is
//     the return of the asset selected at the PREVIOUS month-end.
//
// TradingView's Strategy Tester cannot rotate among multiple ETFs in one true
// portfolio, so this indicator computes a synthetic multi-asset equity curve
// and compares it with buy-and-hold of a benchmark (SPY by default).
//
// Recommended chart: SPY, 1M (monthly) timeframe. Daily/weekly charts also
// work; timeframes above monthly are flagged in the table.
//
// History notes: BOXX launched Dec 2022 and QMOM/IMOM launched Dec 2015. The
// backtest begins once every symbol in use has lookback + 1 completed months
// (~Jan 2024 with BOXX). Swap the defensive asset to AGG or SHV for a longer
// window; do not overtrust the short QMOM/IMOM live history.
//
indicator("Dual Momentum (GEM) — QMOM/IMOM + BOXX", "GEM-QM", overlay = false, max_labels_count = 500)

// ── Inputs ──────────────────────────────────────────────────────────────────
grpS = "Signal ETFs (decide regime & geography)"
sigUSSym   = input.symbol("AMEX:SPY",    "U.S. signal",          group = grpS)
sigIntlSym = input.symbol("NASDAQ:VXUS", "International signal", group = grpS)

grpHo = "Holding ETFs (what the portfolio owns)"
holdUSSym   = input.symbol("BATS:QMOM", "U.S. holding",          group = grpHo)
holdIntlSym = input.symbol("BATS:IMOM", "International holding", group = grpHo)
defSym      = input.symbol("BATS:BOXX", "Defensive holding (risk-off)", group = grpHo)

grpH = "Cash hurdle (absolute momentum)"
hurdleMode   = input.string("BIL", "Hurdle series", options = ["BIL", "SHV", "BOXX", "3M T-Bill yield (FRED:DTB3)", "Custom"], group = grpH,
     tooltip = "Benchmark that U.S. momentum must beat for equities to be eligible. The defensive holding above is what is actually held when risk-off.")
hurdleCustom = input.symbol("AMEX:BIL", "Custom hurdle symbol", group = grpH, tooltip = "Used only when Hurdle series = Custom")

grpM = "Model"
mode = input.string("Decoupled: signal ETFs decide, holding ETFs are owned", "Mode",
     options = ["Baseline: hold the signal ETFs", "Decoupled: signal ETFs decide, holding ETFs are owned", "Aggressive: signals computed on the holding ETFs"],
     group = grpM,
     tooltip = "Baseline = classic GEM (own SPY/VXUS/BOXX). Decoupled = SPY/VXUS/BIL signals, own QMOM/IMOM/BOXX. Aggressive = momentum measured directly on QMOM/IMOM vs the hurdle.")
lookback = input.int(12,     "Momentum lookback (completed months)", minval = 1, maxval = 60, group = grpM)
rebEvery = input.int(1,      "Rebalance every N months",             minval = 1, maxval = 12, group = grpM)
costPct  = input.float(0.05, "Commission per switch (%)",            minval = 0, step = 0.01, group = grpM)
slipPct  = input.float(0.05, "Slippage per switch (%)",              minval = 0, step = 0.01, group = grpM)
startCap = input.float(100000, "Starting portfolio value",           minval = 1, group = grpM)
benchSym = input.symbol("AMEX:SPY", "Benchmark (buy & hold)",        group = grpM)

grpD = "Display"
showTable    = input.bool(true,  "Show stats table", group = grpD)
tablePosStr  = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpD)
showBench    = input.bool(true,  "Plot benchmark equity", group = grpD)
markSwitches = input.bool(true,  "Mark allocation changes", group = grpD)
paintBg      = input.bool(false, "Color background by allocation", group = grpD)
showMomPlots = input.bool(false, "Plot momentum values (%)", group = grpD,
     tooltip = "Momentum shares the pane scale with the equity curves; enable only if you hide the equity plots in the style tab.")

baselineMode   = str.startswith(mode, "Baseline")
aggressiveMode = str.startswith(mode, "Aggressive")

// ── Data (confirmed monthly, dividend adjusted, non-repainting) ─────────────
f_div(simple string s) =>
    ticker.modify(s, adjustment = adjustment.dividends)

hurdleIsYield = hurdleMode == "3M T-Bill yield (FRED:DTB3)"
hurdleSym = hurdleMode == "BIL" ? "AMEX:BIL" : hurdleMode == "SHV" ? "NASDAQ:SHV" : hurdleMode == "BOXX" ? "BATS:BOXX" : hurdleMode == "Custom" ? hurdleCustom : "FRED:DTB3"

// close[1] on the "M" timeframe with lookahead returns the last COMPLETED
// month on every chart bar — the current partial month is never used, so the
// signal cannot repaint intramonth.
f_mom(simple string s) =>
    request.security(f_div(s), "M", close[1] / close[lookback + 1] - 1, lookahead = barmerge.lookahead_on)

f_ret(simple string s) =>
    request.security(f_div(s), "M", close[1] / close[2] - 1, lookahead = barmerge.lookahead_on)

momSigUS    = f_mom(sigUSSym)
momSigIntl  = f_mom(sigIntlSym)
momHoldUS   = f_mom(holdUSSym)
momHoldIntl = f_mom(holdIntlSym)
momDef      = f_mom(defSym)

// Price-based hurdle (BIL / SHV / BOXX / custom): trailing total return.
momHurdlePx = f_mom(hurdleSym)
// Yield-based hurdle (FRED:DTB3, percent annualized): approximate the trailing
// N-month T-bill return as the sum of monthly accruals (yield / 12).
momHurdleYld = request.security(hurdleSym, "M", math.sum(close / 1200.0, lookback)[1], lookahead = barmerge.lookahead_on)
momHurdle = hurdleIsYield ? momHurdleYld : momHurdlePx

retSigUS    = f_ret(sigUSSym)
retSigIntl  = f_ret(sigIntlSym)
retHoldUS   = f_ret(holdUSSym)
retHoldIntl = f_ret(holdIntlSym)
retDef      = f_ret(defSym)
retBench    = f_ret(benchSym)

// Which series decide, and which series are owned, per mode.
momUS   = aggressiveMode ? momHoldUS : momSigUS
momIntl = aggressiveMode ? momHoldIntl : momSigIntl
retUS   = baselineMode ? retSigUS : retHoldUS
retIntl = baselineMode ? retSigIntl : retHoldIntl

// ── Helpers ─────────────────────────────────────────────────────────────────
f_short(string s) =>
    parts = str.split(s, ":")
    n = array.size(parts)
    n > 0 ? array.get(parts, n - 1) : s

sigUSName    = f_short(sigUSSym)
sigIntlName  = f_short(sigIntlSym)
holdUSName   = baselineMode ? sigUSName : f_short(holdUSSym)
holdIntlName = baselineMode ? sigIntlName : f_short(holdIntlSym)
defName      = f_short(defSym)
benchName    = f_short(benchSym)
hurdleName   = hurdleIsYield ? "3M T-Bill" : f_short(hurdleSym)
momUSName    = aggressiveMode ? f_short(holdUSSym) : sigUSName
momIntlName  = aggressiveMode ? f_short(holdIntlSym) : sigIntlName
modeName     = baselineMode ? "Baseline" : aggressiveMode ? "Aggressive" : "Decoupled"

f_name(int t) =>
    t == 0 ? holdUSName : t == 1 ? holdIntlName : t == 2 ? defName : "—"

colUS    = #089981
colIntl  = #2962FF
colDef   = #FF9800
colBench = #787B86

f_targetColor(int t) =>
    t == 0 ? colUS : t == 1 ? colIntl : colDef

// ── Model state ─────────────────────────────────────────────────────────────
var int   target        = -1     // 0 = US, 1 = International, 2 = Defensive
var float equity        = na
var float benchEq       = na
var float peak          = na
var float benchPeak     = na
var float maxDD         = 0.0
var float benchMaxDD    = 0.0
var float sumR          = 0.0
var float sumR2         = 0.0
var float benchSumR     = 0.0
var float benchSumR2    = 0.0
var int   wins          = 0
var int   benchWins     = 0
var int   nMonths       = 0
var int   switches      = 0
var int   monthsSinceReb = 0
var int   startTime     = na

isNewMonth = timeframe.change("M")
// The backtest starts only when every series in use has full lookback history,
// so the equity curve never silently skips an asset with missing data.
ready = not na(momSigUS) and not na(momSigIntl) and not na(momHurdle) and not na(momDef) and (baselineMode or (not na(momHoldUS) and not na(momHoldIntl)))
switchCost = (costPct + slipPct) / 100.0

bool switched = false

if isNewMonth and ready
    bool firstEvent = na(equity)
    if firstEvent
        equity    := startCap
        benchEq   := startCap
        peak      := startCap
        benchPeak := startCap
        startTime := time
    else
        // Accrue the just-completed month using the asset selected at the
        // PREVIOUS month-end (execution convention: switch at next open).
        float heldRet = target == 0 ? retUS : target == 1 ? retIntl : retDef
        heldRet := nz(heldRet)
        float bRet = nz(retBench)
        equity  := equity * (1 + heldRet)
        benchEq := benchEq * (1 + bRet)
        nMonths += 1
        sumR  += heldRet
        sumR2 += heldRet * heldRet
        if heldRet > 0
            wins += 1
        benchSumR  += bRet
        benchSumR2 += bRet * bRet
        if bRet > 0
            benchWins += 1
    // Signal from completed data; acts on the month that is now starting.
    monthsSinceReb += 1
    if firstEvent or monthsSinceReb >= rebEvery
        monthsSinceReb := 0
        int newTarget = momUS <= momHurdle ? 2 : momUS >= momIntl ? 0 : 1
        if newTarget != target
            if not firstEvent
                switches += 1
                equity := equity * (1 - switchCost)
            target := newTarget
            switched := true
    peak       := math.max(peak, equity)
    maxDD      := math.min(maxDD, equity / peak - 1)
    benchPeak  := math.max(benchPeak, benchEq)
    benchMaxDD := math.min(benchMaxDD, benchEq / benchPeak - 1)

// ── Plots & chart markers ───────────────────────────────────────────────────
plot(equity, "Strategy equity", color = color.new(colUS, 0), linewidth = 2)
plot(showBench ? benchEq : na, "Benchmark equity (buy & hold)", color = color.new(colBench, 0), linewidth = 1)

plot(showMomPlots ? momUS * 100 : na,     "US momentum (%)",        color = color.new(colUS, 30))
plot(showMomPlots ? momIntl * 100 : na,   "Intl momentum (%)",      color = color.new(colIntl, 30))
plot(showMomPlots ? momDef * 100 : na,    "Defensive momentum (%)", color = color.new(colDef, 30))
plot(showMomPlots ? momHurdle * 100 : na, "Cash hurdle (%)",        color = color.new(colBench, 30), style = plot.style_circles)

bgcolor(paintBg and target >= 0 ? color.new(f_targetColor(target), 88) : na)

if switched and markSwitches and not na(equity)
    label.new(bar_index, equity, "→ " + f_name(target), style = label.style_label_down, color = f_targetColor(target), textcolor = color.white, size = size.small)

// ── Alerts (fire only when the target asset changes) ────────────────────────
alertcondition(switched, "GEM: allocation change", "Dual Momentum: target allocation changed — open the chart to see the new asset.")
if switched
    alert("Dual Momentum: new target allocation = " + f_name(target), alert.freq_once_per_bar)

// ── Stats table ─────────────────────────────────────────────────────────────
f_pct(float x) =>
    na(x) ? "—" : str.tostring(x * 100, "#.##") + "%"

f_num(float x) =>
    na(x) ? "—" : str.tostring(x, "#.##")

f_money(float x) =>
    na(x) ? "—" : str.tostring(x, "#,###")

tPos = tablePosStr == "Top left" ? position.top_left : tablePosStr == "Bottom right" ? position.bottom_right : tablePosStr == "Bottom left" ? position.bottom_left : tablePosStr == "Middle right" ? position.middle_right : position.top_right

var table tbl = table.new(tPos, 3, 18, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))

if showTable and barstate.islast
    float cagr      = nMonths > 0 ? math.pow(equity / startCap, 12.0 / nMonths) - 1 : na
    float benchCagr = nMonths > 0 ? math.pow(benchEq / startCap, 12.0 / nMonths) - 1 : na
    float meanR      = nMonths > 0 ? sumR / nMonths : na
    float benchMeanR = nMonths > 0 ? benchSumR / nMonths : na
    float varR      = nMonths > 1 ? math.max(0.0, (sumR2 - nMonths * meanR * meanR) / (nMonths - 1)) : na
    float benchVarR = nMonths > 1 ? math.max(0.0, (benchSumR2 - nMonths * benchMeanR * benchMeanR) / (nMonths - 1)) : na
    float vol      = na(varR) ? na : math.sqrt(varR) * math.sqrt(12.0)
    float benchVol = na(benchVarR) ? na : math.sqrt(benchVarR) * math.sqrt(12.0)
    float sharpe      = not na(vol) and vol > 0 ? meanR * 12.0 / vol : na
    float benchSharpe = not na(benchVol) and benchVol > 0 ? benchMeanR * 12.0 / benchVol : na
    float winRate      = nMonths > 0 ? 1.0 * wins / nMonths : na
    float benchWinRate = nMonths > 0 ? 1.0 * benchWins / nMonths : na

    hdr  = color.new(color.white, 0)
    dim  = color.new(#B2B5BE, 0)
    tfWarn = timeframe.in_seconds() > timeframe.in_seconds("1M")

    table.cell(tbl, 0, 0, "Dual Momentum (GEM)", text_color = hdr, text_size = size.small)
    table.cell(tbl, 1, 0, "Strategy", text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 0, benchName + " B&H", text_color = hdr, text_size = size.small)

    table.cell(tbl, 0, 1, "Mode", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 1, modeName, text_color = dim, text_size = size.small)
    table.cell(tbl, 2, 1, "", text_size = size.small)

    table.cell(tbl, 0, 2, "Current allocation", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 2, f_name(target), text_color = target >= 0 ? f_targetColor(target) : dim, text_size = size.small)
    table.cell(tbl, 2, 2, benchName, text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 3, momUSName + " momentum (" + str.tostring(lookback) + "M)", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 3, f_pct(momUS), text_color = momUS > momHurdle ? colUS : color.red, text_size = size.small)
    table.cell(tbl, 2, 3, "", text_size = size.small)

    table.cell(tbl, 0, 4, momIntlName + " momentum", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 4, f_pct(momIntl), text_color = momIntl > momHurdle ? colIntl : color.red, text_size = size.small)
    table.cell(tbl, 2, 4, "", text_size = size.small)

    table.cell(tbl, 0, 5, defName + " momentum", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 5, f_pct(momDef), text_color = dim, text_size = size.small)
    table.cell(tbl, 2, 5, "", text_size = size.small)

    table.cell(tbl, 0, 6, "Cash hurdle (" + hurdleName + ")", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 6, f_pct(momHurdle), text_color = dim, text_size = size.small)
    table.cell(tbl, 2, 6, "", text_size = size.small)

    table.cell(tbl, 0, 7, "CAGR", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 7, f_pct(cagr), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 7, f_pct(benchCagr), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 8, "Max drawdown", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 8, f_pct(maxDD), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 8, f_pct(benchMaxDD), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 9, "Sharpe (rf = 0)", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 9, f_num(sharpe), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 9, f_num(benchSharpe), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 10, "Ann. volatility", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 10, f_pct(vol), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 10, f_pct(benchVol), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 11, "Monthly win rate", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 11, f_pct(winRate), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 11, f_pct(benchWinRate), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 12, "Allocation switches", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 12, str.tostring(switches), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 12, "—", text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 13, "Months backtested", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 13, str.tostring(nMonths), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 13, na(startTime) ? "—" : "since " + str.format_time(startTime, "yyyy-MM"), text_color = dim, text_size = size.small)

    table.cell(tbl, 0, 14, "Portfolio value", text_color = dim, text_size = size.small)
    table.cell(tbl, 1, 14, f_money(equity), text_color = hdr, text_size = size.small)
    table.cell(tbl, 2, 14, f_money(benchEq), text_color = dim, text_size = size.small)

    if tfWarn
        table.cell(tbl, 0, 15, "⚠ Chart timeframe > 1M — use a daily to monthly chart", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 1, 15, "", text_size = size.small)
        table.cell(tbl, 2, 15, "", text_size = size.small)
    if not ready
        table.cell(tbl, 0, 16, "⚠ Waiting for history: every symbol in use needs " + str.tostring(lookback + 1) + " completed months", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 1, 16, "", text_size = size.small)
        table.cell(tbl, 2, 16, "", text_size = size.small)
